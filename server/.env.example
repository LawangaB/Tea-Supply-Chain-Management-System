# Copy to server/.env and fill in real values. Never commit server/.env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smarttea?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
# Set to production on Render so cookies are Secure + SameSite=None
NODE_ENV=development
