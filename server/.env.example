# Copy to server/.env and fill in real values. Never commit server/.env.

# PostgreSQL (Neon). Pooled connection for the app: the host contains "-pooler".
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/smarttea?sslmode=require
# Direct (unpooled) connection for `prisma migrate`: same host without "-pooler".
DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/smarttea?sslmode=require
# Local Docker alternative (docker compose up -d):
# DATABASE_URL=postgresql://smarttea:smarttea@localhost:5432/smarttea
# DIRECT_URL=postgresql://smarttea:smarttea@localhost:5432/smarttea

# Optional: run `npm test` against this server instead of a throw-away embedded Postgres.
# Each test file creates and drops its own schema in it.
# DATABASE_URL_TEST=postgresql://smarttea:smarttea@localhost:5432/smarttea_test

PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
# Set to production on Render so cookies are Secure + SameSite=None
NODE_ENV=development
