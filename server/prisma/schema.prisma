// ══════════════════════════════════ M1 ADMINISTRATION & SECURITY ══════════════════════════════════

/// US-001, US-005, US-006. CHECK cardinality(roles) > 0. passwordHash is omitted by default (config/db.js).
/// Users are deactivated, never deleted, so their history stays (US-005).
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  fullName           String     @map("full_name") @db.VarChar(120)
  email              String     @unique @db.VarChar(160)
  phone              String?    @db.VarChar(20)
  passwordHash       String     @map("password_hash")
  roles              Role[]
  status             UserStatus @default(ACTIVE)
  failedLogins       Int        @default(0) @map("failed_logins")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  // M1
  sessions               UserSession[]
  auditLogs              AuditLog[]
  rolePermissionsUpdated RolePermission[] @relation("RolePermissionUpdatedBy")
  settingsUpdated        SystemSetting[]  @relation("SettingUpdatedBy")
  backupRuns             BackupRun[]      @relation("BackupTriggeredBy")
  notifications          Notification[]
  alertRulesCreated      AlertRule[]      @relation("AlertRuleCreatedBy")

  // Master data (created / approved)
  gradesCreated       TeaGrade[]            @relation("GradeCreatedBy")
  gradesApproved      TeaGrade[]            @relation("GradeApprovedBy")
  parametersCreated   InspectionParameter[] @relation("ParameterCreatedBy")
  parametersApproved  InspectionParameter[] @relation("ParameterApprovedBy")
  tolerancesCreated   Tolerance[]           @relation("ToleranceCreatedBy")
  tolerancesApproved  Tolerance[]           @relation("ToleranceApprovedBy")
  traceFieldsUpdated  TraceabilityFieldSetting[] @relation("TraceFieldUpdatedBy")

  // M2 / M3
  linkedProducers      Producer[]          @relation("ProducerUser")
  registeredProducers  Producer[]          @relation("ProducerRegisteredBy")
  verifiedProducers    Producer[]          @relation("ProducerVerifiedBy")
  harvestsEntered      Harvest[]           @relation("HarvestEnteredBy")
  requestsMade         CollectionRequest[] @relation("RequestRequestedBy")
  requestsAssigned     CollectionRequest[] @relation("RequestAssignedOfficer")
  requestsScheduled    CollectionRequest[] @relation("RequestScheduledBy")
  collections          Collection[]
  receiptsReceived     FactoryReceipt[]    @relation("ReceiptReceivedBy")
  receiptsReviewed     FactoryReceipt[]    @relation("ReceiptReviewedBy")

  // M4 / M6
  inspectionsDone      QualityInspection[]      @relation("InspectionInspector")
  inspectionsDecided   QualityInspection[]      @relation("InspectionDecidedBy")
  exceptionsApproved   RejectedBatchException[] @relation("ExceptionApprovedBy")

  // M5
  processingCreated     ProcessingBatch[]          @relation("ProcessingCreatedBy")
  inputsAllocated       ProcessingInput[]          @relation("InputAllocatedBy")
  stagesOperated        ProcessingStage[]          @relation("StageOperator")
  reconciliationsMade   ProcessingReconciliation[] @relation("ReconSubmittedBy")
  reconciliationsDecided ProcessingReconciliation[] @relation("ReconDecidedBy")

  // M6 / M7
  finishedCreated   FinishedTeaBatch[]  @relation("FinishedCreatedBy")
  finishedReleased  FinishedTeaBatch[]  @relation("FinishedReleasedBy")
  releaseEvents     BatchReleaseEvent[] @relation("ReleaseEventActor")
  qrCodesCreated    QrCode[]            @relation("QrCreatedBy")
  traceIssuesResolved TraceabilityIssue[] @relation("TraceIssueResolvedBy")

  // M8
  stockMovements       StockMovement[]     @relation("MovementPerformedBy")
  adjustmentsRequested StockAdjustment[]   @relation("AdjustmentRequestedBy")
  adjustmentsDecided   StockAdjustment[]   @relation("AdjustmentDecidedBy")
  stockCounts          StockCount[]        @relation("StockCountCountedBy")
  thresholdsRequested  LowStockThreshold[] @relation("ThresholdRequestedBy")
  thresholdsDecided    LowStockThreshold[] @relation("ThresholdDecidedBy")

  // M9 / M10
  buyerProfile         Buyer?               @relation("BuyerUser")
  buyersRegistered     Buyer[]              @relation("BuyerRegisteredBy")
  productsCreated      Product[]            @relation("ProductCreatedBy")
  productBatchesAdded  ProductBatch[]       @relation("ProductBatchAddedBy")
  ordersPlaced         SalesOrder[]         @relation("OrderPlacedBy")
  ordersConfirmed      SalesOrder[]         @relation("OrderConfirmedBy")
  ordersCancelled      SalesOrder[]         @relation("OrderCancelledBy")
  allocationsMade      OrderAllocation[]    @relation("AllocationBy")
  orderStatusChanges   OrderStatusHistory[] @relation("OrderHistoryChangedBy")
  invoicesIssued       Invoice[]            @relation("InvoiceIssuedBy")
  invoicePayments      InvoicePayment[]     @relation("InvoicePaymentRecordedBy")
  pricesCreated        PriceVersion[]       @relation("PriceCreatedBy")
  pricesApproved       PriceVersion[]       @relation("PriceApprovedBy")

  // M11
  adjustmentRulesCreated  PaymentAdjustmentRule[] @relation("AdjRuleCreatedBy")
  adjustmentRulesApproved PaymentAdjustmentRule[] @relation("AdjRuleApprovedBy")
  paymentsPrepared        FarmerPayment[]         @relation("PaymentPreparedBy")
  paymentsApproved        FarmerPayment[]         @relation("PaymentApprovedBy")
  paymentsMarkedPaid      FarmerPayment[]         @relation("PaymentMarkedPaidBy")

  // M12
  transporterProfile Transporter?        @relation("TransporterUser")
  jobsAssigned       TransportJob[]      @relation("JobAssignedBy")
  jobEvents          TransportJobEvent[] @relation("JobEventRecordedBy")
  proofsCaptured     ProofOfDelivery[]   @relation("ProofCapturedBy")

  @@map("app_user")
}

/// US-008. The role-permission matrix as data; rules/permissions.js seeds it and stays the code default.
model Permission {
  code        String           @id @db.VarChar(60)
  module      String           @db.VarChar(40)
  description String?          @db.VarChar(200)
  isSensitive Boolean          @default(false) @map("is_sensitive")
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  role           Role
  permissionCode String          @map("permission_code") @db.VarChar(60)
  scope          PermissionScope @default(ALL)
  updatedById    String?         @map("updated_by_id") @db.Uuid
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  updatedBy  User?      @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([role, permissionCode])
  @@map("role_permission")
}

/// US-001 log out / revoke. Stores only a hash of the refresh token.
model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  ip        String?   @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

/// US-009 password policy & session timeout, US-012 log retention. Keys e.g. "security.password.minLength".
/// ADM may change SECURITY/TECHNICAL only; business rules and prices live in their own tables.
model SystemSetting {
  key         String          @id @db.VarChar(80)
  category    SettingCategory
  value       Json
  description String?         @db.VarChar(300)
  updatedById String?         @map("updated_by_id") @db.Uuid
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("system_setting")
}

/// US-003. Append-only: a trigger refuses UPDATE and DELETE. user_id uses Restrict, because SetNull would be an UPDATE.
model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  action     String
  entityType String        @map("entity_type")
  entityId   String?       @map("entity_id")
  oldValue   Json?         @map("old_value")
  newValue   Json?         @map("new_value")
  reason     String?
  ip         String?
  category   AuditCategory @default(BUSINESS)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@map("audit_log")
}

/// US-010 monitoring, US-012 technical logs (deleted after the retention period; not the audit log).
model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     LogLevel
  source    String   @db.VarChar(80)
  message   String
  context   Json?
  requestId String?  @map("request_id") @db.VarChar(64)
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([level, createdAt])
  @@index([createdAt])
  @@map("system_log")
}

/// US-011. Record of every backup and restore (Neon does the actual work).
model BackupRun {
  id             String        @id @default(uuid()) @db.Uuid
  kind           BackupKind
  triggerType    BackupTrigger @map("trigger_type")
  status         JobRunStatus  @default(RUNNING)
  location       String?       @db.VarChar(300)
  sizeBytes      BigInt?       @map("size_bytes")
  errorMessage   String?       @map("error_message")
  sourceBackupId String?       @map("source_backup_id") @db.Uuid
  triggeredById  String?       @map("triggered_by_id") @db.Uuid
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?     @map("finished_at") @db.Timestamptz(3)

  sourceBackup BackupRun?  @relation("RestoreSource", fields: [sourceBackupId], references: [id], onDelete: Restrict)
  restores     BackupRun[] @relation("RestoreSource")
  triggeredBy  User?       @relation("BackupTriggeredBy", fields: [triggeredById], references: [id], onDelete: Restrict)

  @@index([kind, startedAt])
  @@map("backup_run")
}

// ═══════════════════════════════════ MASTER DATA (US-007, US-027) ══════════════════════════════════
// Draft → Management approval → ACTIVE from effectiveFrom. A change is a NEW version row, so past
// decisions keep pointing at the version that was used.

/// Units for inspection parameters ("%", "C", "count", "kg").
model Unit {
  code       String                @id @db.VarChar(20)
  name       String                @db.VarChar(60)
  parameters InspectionParameter[]

  @@map("unit")
}

/// Finished-tea grades (BOP, BOPF, OP, FBOP, Dust …). CHECK version >= 1.
model TeaGrade {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @db.VarChar(20)
  version         Int            @default(1)
  name            String         @db.VarChar(80)
  description     String?        @db.VarChar(300)
  sortOrder       Int            @default(0) @map("sort_order")
  status          ApprovalStatus @default(DRAFT)
  effectiveFrom   DateTime?      @map("effective_from") @db.Timestamptz(3)
  createdById     String         @map("created_by_id") @db.Uuid
  approvedById    String?        @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(3)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(300)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy       User                    @relation("GradeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?                   @relation("GradeApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  inspections     QualityInspection[]
  finishedBatches FinishedTeaBatch[]
  products        Product[]
  prices          PriceVersion[]
  adjustmentRules PaymentAdjustmentRule[]

  @@unique([code, version])
  @@index([status])
  @@map("tea_grade")
}

/// Inspection parameters with ranges (US-024 reject out-of-range input, US-025 accept / adjust / reject).
/// allowed = valid input range · standard = Accepted · adjustment = Accepted with adjustment (deductionPct).
/// CHECK min <= max for each pair, deduction_pct 0..100, version >= 1.
model InspectionParameter {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @db.VarChar(30)
  version         Int               @default(1)
  name            String            @db.VarChar(80)
  subject         InspectionSubject
  unitCode        String            @map("unit_code") @db.VarChar(20)
  allowedMin      Decimal?          @map("allowed_min") @db.Decimal(12, 3)
  allowedMax      Decimal?          @map("allowed_max") @db.Decimal(12, 3)
  standardMin     Decimal?          @map("standard_min") @db.Decimal(12, 3)
  standardMax     Decimal?          @map("standard_max") @db.Decimal(12, 3)
  adjustmentMin   Decimal?          @map("adjustment_min") @db.Decimal(12, 3)
  adjustmentMax   Decimal?          @map("adjustment_max") @db.Decimal(12, 3)
  deductionPct    Decimal?          @map("deduction_pct") @db.Decimal(5, 2)
  isRequired      Boolean           @default(true) @map("is_required")
  status          ApprovalStatus    @default(DRAFT)
  effectiveFrom   DateTime?         @map("effective_from") @db.Timestamptz(3)
  createdById     String            @map("created_by_id") @db.Uuid
  approvedById    String?           @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?         @map("approved_at") @db.Timestamptz(3)
  rejectionReason String?           @map("rejection_reason") @db.VarChar(300)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit       Unit               @relation(fields: [unitCode], references: [code], onDelete: Restrict)
  createdBy  User               @relation("ParameterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?              @relation("ParameterApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  results    InspectionResult[]

  @@unique([code, version])
  @@index([subject, status])
  @@map("inspection_parameter")
}

/// Tolerances used by business rules: factory receipt weight difference (US-023), processing variance
/// (US-030), stock count difference. CHECK value >= 0, version >= 1.
model Tolerance {
  id              String         @id @default(uuid()) @db.Uuid
  type            ToleranceType
  version         Int            @default(1)
  value           Decimal        @db.Decimal(12, 3)
  isPercent       Boolean        @default(true) @map("is_percent")
  description     String?        @db.VarChar(300)
  status          ApprovalStatus @default(DRAFT)
  effectiveFrom   DateTime?      @map("effective_from") @db.Timestamptz(3)
  createdById     String         @map("created_by_id") @db.Uuid
  approvedById    String?        @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(3)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(300)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy       User                       @relation("ToleranceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?                      @relation("ToleranceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  factoryReceipts FactoryReceipt[]
  reconciliations ProcessingReconciliation[]

  @@unique([type, version])
  @@index([type, status])
  @@map("tolerance")
}

// ═══════════════════════════════════ M2 PRODUCERS, ESTATES, FIELDS ════════════════════════════════

model CollectionCentre {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(10)
  name        String
  district    String
  producers   Producer[]
  collections Collection[]
  routes      CollectionRoute[]

  @@map("collection_centre")
}

model ProducerOrg {
  id        String     @id @default(uuid()) @db.Uuid
  regNo     String     @unique @map("reg_no")
  name      String
  producers Producer[]

  @@map("producer_org")
}

/// US-014, US-015. CHECK type <> 'ORG_MEMBER' OR org_id IS NOT NULL. Code format (PRD-NNNNN) is checked in the app.
model Producer {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique @db.VarChar(20)
  type               ProducerType
  fullName           String             @map("full_name") @db.VarChar(120)
  nicOrRegNo         String             @unique @map("nic_or_reg_no") @db.VarChar(30)
  phone              String?            @db.VarChar(20)
  address            String?            @db.VarChar(300)
  centreId           String             @map("centre_id") @db.Uuid
  orgId              String?            @map("org_id") @db.Uuid
  userId             String?            @map("user_id") @db.Uuid
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason") @db.VarChar(300)
  registeredById     String             @map("registered_by_id") @db.Uuid
  verifiedById       String?            @map("verified_by_id") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  centre             CollectionCentre    @relation(fields: [centreId], references: [id], onDelete: Restrict)
  org                ProducerOrg?        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user               User?               @relation("ProducerUser", fields: [userId], references: [id], onDelete: SetNull)
  registeredBy       User                @relation("ProducerRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  verifiedBy         User?               @relation("ProducerVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  fields             Field[]
  collections        Collection[]
  collectionRequests CollectionRequest[]
  payments           FarmerPayment[]

  @@index([userId])
  @@index([verificationStatus])
  @@map("producer")
}

/// US-016. CHECK area_ha > 0 AND area_ha <= 10000; GPS in range and both-or-neither.
model Field {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique @db.VarChar(20)
  producerId String      @map("producer_id") @db.Uuid
  division   String?     @db.VarChar(80)
  areaHa     Decimal     @map("area_ha") @db.Decimal(10, 3)
  variety    String?     @db.VarChar(80)
  gpsLat     Float?      @map("gps_lat")
  gpsLng     Float?      @map("gps_lng")
  status     FieldStatus @default(ACTIVE)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  producer           Producer            @relation(fields: [producerId], references: [id], onDelete: Restrict)
  collections        Collection[]
  harvests           Harvest[]
  collectionRequests CollectionRequest[]

  @@index([producerId])
  @@map("field")
}

/// US-017. A harvest belongs to a field (and so to its producer). enteredBy shows who recorded it
/// (the farmer, or an officer on the farmer's behalf). CHECK estimated_kg > 0.
model Harvest {
  id          String   @id @default(uuid()) @db.Uuid
  fieldId     String   @map("field_id") @db.Uuid
  harvestDate DateTime @map("harvest_date") @db.Date
  estimatedKg Decimal  @map("estimated_kg") @db.Decimal(10, 3)
  notes       String?  @db.VarChar(300)
  enteredById String   @map("entered_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  field     Field               @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  enteredBy User                @relation("HarvestEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)
  requests  CollectionRequest[]

  @@index([fieldId, harvestDate])
  @@map("harvest")
}

// ═════════════════════════════════════ M3 COLLECTION & WEIGHING ═══════════════════════════════════

model CollectionRoute {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(80)
  centreId String  @map("centre_id") @db.Uuid
  isActive Boolean @default(true) @map("is_active")

  centre   CollectionCentre    @relation(fields: [centreId], references: [id], onDelete: Restrict)
  requests CollectionRequest[]

  @@map("collection_route")
}

/// US-019. Farmer requests → officer schedules (date, route, officer) → optional transport job → collected.
/// CHECK estimated_kg NULL or > 0; SCHEDULED needs scheduled_at.
model CollectionRequest {
  id                String                  @id @default(uuid()) @db.Uuid
  requestNo         String                  @unique @map("request_no") @db.VarChar(20)
  producerId        String                  @map("producer_id") @db.Uuid
  fieldId           String?                 @map("field_id") @db.Uuid
  harvestId         String?                 @map("harvest_id") @db.Uuid
  requestedById     String                  @map("requested_by_id") @db.Uuid
  preferredDate     DateTime                @map("preferred_date") @db.Date
  estimatedKg       Decimal?                @map("estimated_kg") @db.Decimal(10, 3)
  status            CollectionRequestStatus @default(REQUESTED)
  scheduledAt       DateTime?               @map("scheduled_at") @db.Timestamptz(3)
  routeId           String?                 @map("route_id") @db.Uuid
  assignedOfficerId String?                 @map("assigned_officer_id") @db.Uuid
  scheduledById     String?                 @map("scheduled_by_id") @db.Uuid
  transportJobId    String?                 @map("transport_job_id") @db.Uuid
  cancelReason      String?                 @map("cancel_reason") @db.VarChar(300)
  notes             String?                 @db.VarChar(300)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  producer        Producer         @relation(fields: [producerId], references: [id], onDelete: Restrict)
  field           Field?           @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  harvest         Harvest?         @relation(fields: [harvestId], references: [id], onDelete: Restrict)
  requestedBy     User             @relation("RequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  route           CollectionRoute? @relation(fields: [routeId], references: [id], onDelete: Restrict)
  assignedOfficer User?            @relation("RequestAssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: Restrict)
  scheduledBy     User?            @relation("RequestScheduledBy", fields: [scheduledById], references: [id], onDelete: Restrict)
  transportJob    TransportJob?    @relation(fields: [transportJobId], references: [id], onDelete: Restrict)
  collection      Collection?

  @@index([producerId])
  @@index([status, scheduledAt])
  @@index([assignedOfficerId])
  @@index([transportJobId])
  @@map("collection_request")
}

/// US-020 weighing, US-021 receipt (receiptNo). CHECK net_kg = round(gross_kg - tare_kg, 3);
/// 0 < gross_kg <= 10000; 0 <= tare_kg < gross_kg; price_per_kg >= 0. Receipt format (RC-NNNNN) is checked in the app.
/// pricePerKg is copied from the price version, so later price changes never change past collections (US-057).
model Collection {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNo       String   @unique @map("receipt_no") @db.VarChar(20)
  producerId      String   @map("producer_id") @db.Uuid
  fieldId         String   @map("field_id") @db.Uuid
  centreId        String?  @map("centre_id") @db.Uuid
  collectorId     String   @map("collector_id") @db.Uuid
  collectedAt     DateTime @default(now()) @map("collected_at") @db.Timestamptz(3)
  grossKg         Decimal  @map("gross_kg") @db.Decimal(10, 3)
  tareKg          Decimal  @map("tare_kg") @db.Decimal(10, 3)
  netKg           Decimal  @map("net_kg") @db.Decimal(10, 3)
  purchasePriceId String   @map("purchase_price_id") @db.Uuid
  pricePerKg      Decimal  @map("price_per_kg") @db.Decimal(12, 2)
  requestId       String?  @unique @map("request_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  producer      Producer           @relation(fields: [producerId], references: [id], onDelete: Restrict)
  field         Field              @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  centre        CollectionCentre?  @relation(fields: [centreId], references: [id], onDelete: Restrict)
  collector     User               @relation(fields: [collectorId], references: [id], onDelete: Restrict)
  purchasePrice PriceVersion       @relation(fields: [purchasePriceId], references: [id], onDelete: Restrict)
  request       CollectionRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  batch         GreenLeafBatch?
  paymentLine   FarmerPaymentLine?

  @@index([producerId])
  @@index([collectedAt])
  @@index([collectorId, collectedAt])
  @@map("collection")
}

/// US-022. 1:1 with Collection via the unique collection_id; batchCode can never be changed (trigger).
/// acceptedKg = weight after the quality decision; availableKg = accepted kg not yet put into processing (US-028).
/// CHECK net_kg >= 0, accepted_kg NULL or >= 0, available_kg NULL or 0..accepted_kg.
/// Batch code format (GL-YYYY-MM-NNNN) is checked in the app.
model GreenLeafBatch {
  id           String      @id @default(uuid()) @db.Uuid
  batchCode    String      @unique @map("batch_code") @db.VarChar(30)
  collectionId String      @unique @map("collection_id") @db.Uuid
  netKg        Decimal     @map("net_kg") @db.Decimal(10, 3)
  acceptedKg   Decimal?    @map("accepted_kg") @db.Decimal(10, 3)
  availableKg  Decimal?    @map("available_kg") @db.Decimal(10, 3)
  status       BatchStatus @default(IN_TRANSIT)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  collection       Collection              @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  factoryReceipt   FactoryReceipt?
  inspections      QualityInspection[]
  exception        RejectedBatchException?
  processingInputs ProcessingInput[]
  traceIssues      TraceabilityIssue[]

  @@index([status])
  @@map("green_leaf_batch")
}

model Factory {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique @db.VarChar(10)
  name              String            @db.VarChar(120)
  address           String?           @db.VarChar(300)
  isActive          Boolean           @default(true) @map("is_active")
  receipts          FactoryReceipt[]
  processingBatches ProcessingBatch[]
  warehouses        Warehouse[]

  @@map("factory")
}

/// US-023. One receipt per green-leaf batch. discrepancyKg = receivedKg − batch netKg; isFlagged when it is
/// outside the RECEIPT_WEIGHT tolerance (reviewStatus PENDING until reviewed). CHECK received_kg >= 0.
model FactoryReceipt {
  id             String              @id @default(uuid()) @db.Uuid
  batchId        String              @unique @map("batch_id") @db.Uuid
  factoryId      String              @map("factory_id") @db.Uuid
  receivedKg     Decimal             @map("received_kg") @db.Decimal(10, 3)
  discrepancyKg  Decimal             @map("discrepancy_kg") @db.Decimal(10, 3)
  discrepancyPct Decimal?            @map("discrepancy_pct") @db.Decimal(7, 3)
  toleranceId    String?             @map("tolerance_id") @db.Uuid
  isFlagged      Boolean             @default(false) @map("is_flagged")
  reviewStatus   ReceiptReviewStatus @default(NOT_REQUIRED) @map("review_status")
  reviewNote     String?             @map("review_note") @db.VarChar(500)
  reviewedById   String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  receivedById   String              @map("received_by_id") @db.Uuid
  receivedAt     DateTime            @default(now()) @map("received_at") @db.Timestamptz(3)

  batch      GreenLeafBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  factory    Factory        @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  tolerance  Tolerance?     @relation(fields: [toleranceId], references: [id], onDelete: Restrict)
  receivedBy User           @relation("ReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  reviewedBy User?          @relation("ReceiptReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([factoryId, receivedAt])
  @@index([reviewStatus])
  @@map("factory_receipt")
}

// ═════════════════════════════════ M4 + M6 QUALITY INSPECTION ═════════════════════════════════════

/// One table for green-leaf (US-024/025) and finished-tea (US-032) inspections.
/// CHECK exactly one of green_leaf_batch_id / finished_batch_id, matching subject; decision only for
/// GREEN_LEAF; ACCEPTED_WITH_ADJUSTMENT needs adjusted_kg and a reason; REJECTED needs a reason;
/// deduction_pct 0..100.
model QualityInspection {
  id               String            @id @default(uuid()) @db.Uuid
  inspectionNo     String            @unique @map("inspection_no") @db.VarChar(20)
  subject          InspectionSubject
  greenLeafBatchId String?           @map("green_leaf_batch_id") @db.Uuid
  finishedBatchId  String?           @map("finished_batch_id") @db.Uuid
  gradeId          String?           @map("grade_id") @db.Uuid
  inspectorId      String            @map("inspector_id") @db.Uuid
  inspectedAt      DateTime          @default(now()) @map("inspected_at") @db.Timestamptz(3)
  notes            String?           @db.VarChar(500)
  decision         LeafDecision?
  adjustedKg       Decimal?          @map("adjusted_kg") @db.Decimal(10, 3)
  deductionPct     Decimal?          @map("deduction_pct") @db.Decimal(5, 2)
  decisionReason   String?           @map("decision_reason") @db.VarChar(500)
  decidedById      String?           @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?         @map("decided_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  greenLeafBatch GreenLeafBatch?    @relation(fields: [greenLeafBatchId], references: [id], onDelete: Restrict)
  finishedBatch  FinishedTeaBatch?  @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  grade          TeaGrade?          @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  inspector      User               @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  decidedBy      User?              @relation("InspectionDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  results        InspectionResult[]

  @@index([greenLeafBatchId])
  @@index([finishedBatchId])
  @@index([inspectedAt])
  @@map("quality_inspection")
}

/// One measured value per parameter (the parameter VERSION used, so later rule changes don't alter it).
model InspectionResult {
  id               String  @id @default(uuid()) @db.Uuid
  inspectionId     String  @map("inspection_id") @db.Uuid
  parameterId      String  @map("parameter_id") @db.Uuid
  value            Decimal @db.Decimal(12, 3)
  withinStandard   Boolean @map("within_standard")
  withinAdjustment Boolean @default(false) @map("within_adjustment")

  inspection QualityInspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  parameter  InspectionParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, parameterId])
  @@index([parameterId])
  @@map("inspection_result")
}

/// US-026 (Could). Management lets a REJECTED batch be used for processing, with a reason.
model RejectedBatchException {
  id           String   @id @default(uuid()) @db.Uuid
  batchId      String   @unique @map("batch_id") @db.Uuid
  reason       String   @db.VarChar(500)
  approvedById String   @map("approved_by_id") @db.Uuid
  approvedAt   DateTime @default(now()) @map("approved_at") @db.Timestamptz(3)

  batch      GreenLeafBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  approvedBy User           @relation("ExceptionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@map("rejected_batch_exception")
}

// ═══════════════════════════════════════ M5 PROCESSING ════════════════════════════════════════════

/// US-028. Code format PB-YYYY-MM-NNNN (app).
model ProcessingBatch {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(30)
  factoryId   String?          @map("factory_id") @db.Uuid
  status      ProcessingStatus @default(OPEN)
  startedAt   DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(3)
  notes       String?          @db.VarChar(500)
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  factory        Factory?                  @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("ProcessingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  inputs         ProcessingInput[]
  stages         ProcessingStage[]
  reconciliation ProcessingReconciliation?
  finishedOutput FinishedBatchSource[]
  traceIssues    TraceabilityIssue[]

  @@index([status])
  @@map("processing_batch")
}

/// Genealogy link green-leaf batch → processing batch, with the kg used (US-028, US-035).
/// CHECK allocated_kg > 0. "Not more than available" is checked in the app inside the same transaction.
model ProcessingInput {
  id                String   @id @default(uuid()) @db.Uuid
  processingBatchId String   @map("processing_batch_id") @db.Uuid
  greenLeafBatchId  String   @map("green_leaf_batch_id") @db.Uuid
  allocatedKg       Decimal  @map("allocated_kg") @db.Decimal(10, 3)
  allocatedById     String   @map("allocated_by_id") @db.Uuid
  allocatedAt       DateTime @default(now()) @map("allocated_at") @db.Timestamptz(3)

  processingBatch ProcessingBatch @relation(fields: [processingBatchId], references: [id], onDelete: Restrict)
  greenLeafBatch  GreenLeafBatch  @relation(fields: [greenLeafBatchId], references: [id], onDelete: Restrict)
  allocatedBy     User            @relation("InputAllocatedBy", fields: [allocatedById], references: [id], onDelete: Restrict)

  @@unique([processingBatchId, greenLeafBatchId])
  @@index([greenLeafBatchId])
  @@map("processing_input")
}

/// US-029. CHECK input_kg > 0; output/by-product/loss >= 0; output + by-product + loss <= input; ended_at >= started_at.
model ProcessingStage {
  id                String              @id @default(uuid()) @db.Uuid
  processingBatchId String              @map("processing_batch_id") @db.Uuid
  sequence          Int
  stageType         ProcessingStageType @map("stage_type")
  inputKg           Decimal             @map("input_kg") @db.Decimal(10, 3)
  outputKg          Decimal             @map("output_kg") @db.Decimal(10, 3)
  byProductKg       Decimal             @default(0) @map("by_product_kg") @db.Decimal(10, 3)
  lossKg            Decimal             @default(0) @map("loss_kg") @db.Decimal(10, 3)
  byProductNote     String?             @map("by_product_note") @db.VarChar(300)
  operatorId        String              @map("operator_id") @db.Uuid
  startedAt         DateTime            @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?           @map("ended_at") @db.Timestamptz(3)
  notes             String?             @db.VarChar(500)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  processingBatch ProcessingBatch @relation(fields: [processingBatchId], references: [id], onDelete: Restrict)
  operator        User            @relation("StageOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  @@unique([processingBatchId, sequence])
  @@map("processing_stage")
}

/// US-030. Within tolerance → AUTO_ACCEPTED; outside → PENDING_APPROVAL (reason required) → Management decides.
/// CHECK kg values >= 0; PENDING_APPROVAL needs reason; APPROVED/REJECTED need decided_by_id + decision_reason.
model ProcessingReconciliation {
  id                String               @id @default(uuid()) @db.Uuid
  processingBatchId String               @unique @map("processing_batch_id") @db.Uuid
  inputKg           Decimal              @map("input_kg") @db.Decimal(10, 3)
  outputKg          Decimal              @map("output_kg") @db.Decimal(10, 3)
  byProductKg       Decimal              @map("by_product_kg") @db.Decimal(10, 3)
  lossKg            Decimal              @map("loss_kg") @db.Decimal(10, 3)
  varianceKg        Decimal              @map("variance_kg") @db.Decimal(10, 3)
  variancePct       Decimal              @map("variance_pct") @db.Decimal(7, 3)
  toleranceId       String?              @map("tolerance_id") @db.Uuid
  withinTolerance   Boolean              @map("within_tolerance")
  status            ReconciliationStatus
  reason            String?              @db.VarChar(500)
  submittedById     String               @map("submitted_by_id") @db.Uuid
  submittedAt       DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedById       String?              @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?            @map("decided_at") @db.Timestamptz(3)
  decisionReason    String?              @map("decision_reason") @db.VarChar(500)

  processingBatch ProcessingBatch @relation(fields: [processingBatchId], references: [id], onDelete: Restrict)
  tolerance       Tolerance?      @relation(fields: [toleranceId], references: [id], onDelete: Restrict)
  submittedBy     User            @relation("ReconSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  decidedBy       User?           @relation("ReconDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("processing_reconciliation")
}

// ═══════════════════════════════ M6 FINISHED TEA + M7 TRACEABILITY ════════════════════════════════

/// US-031 create, US-032 grade, US-033/034 release / hold / revoke. Code format FT-YYYY-MM-NNNN (app).
/// Sources are in FinishedBatchSource (a blend may come from several processing batches).
/// CHECK quantity_kg > 0; yield_pct 0..100; RELEASED needs released_by_id + released_at.
model FinishedTeaBatch {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(30)
  gradeId       String?       @map("grade_id") @db.Uuid
  quantityKg    Decimal       @map("quantity_kg") @db.Decimal(12, 3)
  inputKg       Decimal?      @map("input_kg") @db.Decimal(12, 3)
  yieldPct      Decimal?      @map("yield_pct") @db.Decimal(6, 3)
  producedAt    DateTime      @default(now()) @map("produced_at") @db.Timestamptz(3)
  releaseStatus ReleaseStatus @default(NOT_RELEASED) @map("release_status")
  releasedById  String?       @map("released_by_id") @db.Uuid
  releasedAt    DateTime?     @map("released_at") @db.Timestamptz(3)
  hasTraceGap   Boolean       @default(false) @map("has_trace_gap")
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  grade          TeaGrade?             @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  releasedBy     User?                 @relation("FinishedReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  createdBy      User                  @relation("FinishedCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sources        FinishedBatchSource[]
  inspections    QualityInspection[]
  releaseEvents  BatchReleaseEvent[]
  qrCode         QrCode?
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  adjustments    StockAdjustment[]
  countLines     StockCountLine[]
  productLinks   ProductBatch[]
  allocations    OrderAllocation[]
  traceIssues    TraceabilityIssue[]

  @@index([releaseStatus])
  @@index([gradeId])
  @@map("finished_tea_batch")
}

/// Genealogy link processing batch → finished batch (US-031, US-035). CHECK quantity_kg NULL or > 0.
model FinishedBatchSource {
  finishedBatchId   String   @map("finished_batch_id") @db.Uuid
  processingBatchId String   @map("processing_batch_id") @db.Uuid
  quantityKg        Decimal? @map("quantity_kg") @db.Decimal(12, 3)

  finishedBatch   FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  processingBatch ProcessingBatch  @relation(fields: [processingBatchId], references: [id], onDelete: Restrict)

  @@id([finishedBatchId, processingBatchId])
  @@index([processingBatchId])
  @@map("finished_batch_source")
}

/// History of release / hold / revoke with reasons (US-033, US-034). Append-only (trigger).
model BatchReleaseEvent {
  id              String        @id @default(uuid()) @db.Uuid
  finishedBatchId String        @map("finished_batch_id") @db.Uuid
  action          ReleaseAction
  fromStatus      ReleaseStatus @map("from_status")
  toStatus        ReleaseStatus @map("to_status")
  reason          String?       @db.VarChar(500)
  actorId         String        @map("actor_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  actor         User             @relation("ReleaseEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([finishedBatchId, createdAt])
  @@map("batch_release_event")
}

/// US-036. One QR per finished batch; a reprint returns the same token (count + audit log entry).
/// token is a random value (not the batch code), the QR opens /trace/<token> behind login (US-037).
model QrCode {
  id              String    @id @default(uuid()) @db.Uuid
  finishedBatchId String    @unique @map("finished_batch_id") @db.Uuid
  token           String    @unique @db.VarChar(64)
  printCount      Int       @default(1) @map("print_count")
  lastPrintedAt   DateTime? @map("last_printed_at") @db.Timestamptz(3)
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  createdBy     User             @relation("QrCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("qr_code")
}

/// US-038. Which traceability fields buyers / farmers see on the QR page (default: estate/region only).
model TraceabilityFieldSetting {
  fieldKey        String   @id @map("field_key") @db.VarChar(60)
  label           String   @db.VarChar(80)
  visibleToBuyer  Boolean  @default(false) @map("visible_to_buyer")
  visibleToFarmer Boolean  @default(false) @map("visible_to_farmer")
  isPersonalData  Boolean  @default(false) @map("is_personal_data")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("TraceFieldUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("traceability_field_setting")
}

/// US-039. Gaps found by the nightly / on-save check; resolvedAt set when the link is added.
/// CHECK at least one batch id is set.
model TraceabilityIssue {
  id                String         @id @default(uuid()) @db.Uuid
  issueType         TraceIssueType @map("issue_type")
  finishedBatchId   String?        @map("finished_batch_id") @db.Uuid
  processingBatchId String?        @map("processing_batch_id") @db.Uuid
  greenLeafBatchId  String?        @map("green_leaf_batch_id") @db.Uuid
  details           String?        @db.VarChar(500)
  detectedAt        DateTime       @default(now()) @map("detected_at") @db.Timestamptz(3)
  resolvedAt        DateTime?      @map("resolved_at") @db.Timestamptz(3)
  resolvedById      String?        @map("resolved_by_id") @db.Uuid

  finishedBatch   FinishedTeaBatch? @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  processingBatch ProcessingBatch?  @relation(fields: [processingBatchId], references: [id], onDelete: Restrict)
  greenLeafBatch  GreenLeafBatch?   @relation(fields: [greenLeafBatchId], references: [id], onDelete: Restrict)
  resolvedBy      User?             @relation("TraceIssueResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([resolvedAt])
  @@index([finishedBatchId])
  @@map("traceability_issue")
}

// ═══════════════════════════════════════ M8 WAREHOUSE ═════════════════════════════════════════════

/// US-040. Warehouse → area → storage location. Deactivate (isActive=false), never delete.
model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique @db.VarChar(10)
  name      String          @db.VarChar(120)
  address   String?         @db.VarChar(300)
  factoryId String?         @map("factory_id") @db.Uuid
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  factory Factory?        @relation(fields: [factoryId], references: [id], onDelete: Restrict)
  areas   WarehouseArea[]
  counts  StockCount[]

  @@map("warehouse")
}

model WarehouseArea {
  id          String  @id @default(uuid()) @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  code        String  @db.VarChar(10)
  name        String  @db.VarChar(80)
  isActive    Boolean @default(true) @map("is_active")

  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locations StorageLocation[]

  @@unique([warehouseId, code])
  @@map("warehouse_area")
}

/// CHECK capacity_kg NULL or > 0.
model StorageLocation {
  id         String   @id @default(uuid()) @db.Uuid
  areaId     String   @map("area_id") @db.Uuid
  code       String   @db.VarChar(20)
  name       String?  @db.VarChar(80)
  capacityKg Decimal? @map("capacity_kg") @db.Decimal(12, 3)
  isActive   Boolean  @default(true) @map("is_active")

  area          WarehouseArea     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  balances      StockBalance[]
  movementsFrom StockMovement[]   @relation("MovementFrom")
  movementsTo   StockMovement[]   @relation("MovementTo")
  adjustments   StockAdjustment[]
  countLines    StockCountLine[]
  allocations   OrderAllocation[]

  @@unique([areaId, code])
  @@map("storage_location")
}

/// US-041..045, US-053. Current stock per finished batch per location. available = on_hand − reserved.
/// CHECK on_hand_kg >= 0, reserved_kg >= 0, reserved_kg <= on_hand_kg  → the database itself refuses
/// overselling, even when two orders reserve at the same time (US-053). Use UPDATE … WHERE in a transaction.
model StockBalance {
  id              String   @id @default(uuid()) @db.Uuid
  finishedBatchId String   @map("finished_batch_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  onHandKg        Decimal  @default(0) @map("on_hand_kg") @db.Decimal(12, 3)
  reservedKg      Decimal  @default(0) @map("reserved_kg") @db.Decimal(12, 3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  location      StorageLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([finishedBatchId, locationId])
  @@index([locationId])
  @@map("stock_balance")
}

/// Every stock change (stock-in, transfer, adjustment, reserve, release, dispatch). Append-only (trigger).
/// CHECK quantity_kg > 0; STOCK_IN needs to_location; TRANSFER needs both locations and they differ.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  type            StockMovementType
  finishedBatchId String            @map("finished_batch_id") @db.Uuid
  fromLocationId  String?           @map("from_location_id") @db.Uuid
  toLocationId    String?           @map("to_location_id") @db.Uuid
  quantityKg      Decimal           @map("quantity_kg") @db.Decimal(12, 3)
  orderId         String?           @map("order_id") @db.Uuid
  adjustmentId    String?           @map("adjustment_id") @db.Uuid
  note            String?           @db.VarChar(300)
  performedById   String            @map("performed_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  fromLocation  StorageLocation? @relation("MovementFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    StorageLocation? @relation("MovementTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  order         SalesOrder?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  adjustment    StockAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  performedBy   User             @relation("MovementPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([finishedBatchId, createdAt])
  @@index([orderId])
  @@index([createdAt])
  @@map("stock_movement")
}

/// US-043 damaged / downgraded stock, US-044 count differences → Management approval.
/// deltaKg < 0 reduces stock. CHECK delta_kg <> 0; APPROVED/REJECTED need decided_by_id.
model StockAdjustment {
  id              String           @id @default(uuid()) @db.Uuid
  adjustmentNo    String           @unique @map("adjustment_no") @db.VarChar(20)
  finishedBatchId String           @map("finished_batch_id") @db.Uuid
  locationId      String           @map("location_id") @db.Uuid
  deltaKg         Decimal          @map("delta_kg") @db.Decimal(12, 3)
  reason          AdjustmentReason
  note            String?          @db.VarChar(500)
  countLineId     String?          @unique @map("count_line_id") @db.Uuid
  status          DecisionStatus   @default(PENDING)
  requestedById   String           @map("requested_by_id") @db.Uuid
  requestedAt     DateTime         @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedById     String?          @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?        @map("decided_at") @db.Timestamptz(3)
  decisionReason  String?          @map("decision_reason") @db.VarChar(500)

  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  location      StorageLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  countLine     StockCountLine?  @relation(fields: [countLineId], references: [id], onDelete: Restrict)
  requestedBy   User             @relation("AdjustmentRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy     User?            @relation("AdjustmentDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  movements     StockMovement[]

  @@index([status])
  @@map("stock_adjustment")
}

/// US-044 physical stock count.
model StockCount {
  id          String           @id @default(uuid()) @db.Uuid
  countNo     String           @unique @map("count_no") @db.VarChar(20)
  warehouseId String           @map("warehouse_id") @db.Uuid
  status      StockCountStatus @default(DRAFT)
  notes       String?          @db.VarChar(500)
  countedById String           @map("counted_by_id") @db.Uuid
  countedAt   DateTime         @default(now()) @map("counted_at") @db.Timestamptz(3)
  submittedAt DateTime?        @map("submitted_at") @db.Timestamptz(3)

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  countedBy User             @relation("StockCountCountedBy", fields: [countedById], references: [id], onDelete: Restrict)
  lines     StockCountLine[]

  @@map("stock_count")
}

/// CHECK system_kg >= 0, counted_kg >= 0, difference_kg = counted_kg − system_kg.
model StockCountLine {
  id              String  @id @default(uuid()) @db.Uuid
  countId         String  @map("count_id") @db.Uuid
  finishedBatchId String  @map("finished_batch_id") @db.Uuid
  locationId      String  @map("location_id") @db.Uuid
  systemKg        Decimal @map("system_kg") @db.Decimal(12, 3)
  countedKg       Decimal @map("counted_kg") @db.Decimal(12, 3)
  differenceKg    Decimal @map("difference_kg") @db.Decimal(12, 3)

  stockCount    StockCount       @relation(fields: [countId], references: [id], onDelete: Cascade)
  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  location      StorageLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  adjustment    StockAdjustment?

  @@unique([countId, finishedBatchId, locationId])
  @@map("stock_count_line")
}

/// US-046. Threshold per product; active once Management approves. CHECK threshold_kg > 0.
model LowStockThreshold {
  id             String         @id @default(uuid()) @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  thresholdKg    Decimal        @map("threshold_kg") @db.Decimal(12, 3)
  notifyRoles    Role[]         @map("notify_roles")
  status         DecisionStatus @default(PENDING)
  requestedById  String         @map("requested_by_id") @db.Uuid
  decidedById    String?        @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionReason String?        @map("decision_reason") @db.VarChar(300)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("ThresholdRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("ThresholdDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@map("low_stock_threshold")
}

// ═══════════════════════════════ M9 BUYERS, CATALOGUE, ORDERS ═════════════════════════════════════

/// US-047. A buyer company with its login (userId, role BUY).
model Buyer {
  id             String      @id @default(uuid()) @db.Uuid
  code           String      @unique @db.VarChar(20)
  companyName    String      @map("company_name") @db.VarChar(160)
  contactName    String?     @map("contact_name") @db.VarChar(120)
  email          String?     @db.VarChar(160)
  phone          String?     @db.VarChar(20)
  address        String?     @db.VarChar(300)
  country        String?     @db.VarChar(60)
  taxNo          String?     @map("tax_no") @db.VarChar(40)
  userId         String?     @unique @map("user_id") @db.Uuid
  status         BuyerStatus @default(ACTIVE)
  registeredById String      @map("registered_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?        @relation("BuyerUser", fields: [userId], references: [id], onDelete: Restrict)
  registeredBy User         @relation("BuyerRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  orders       SalesOrder[]

  @@map("buyer")
}

/// US-048. A catalogue item (grade + description). Stock comes from the released batches linked in ProductBatch.
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String        @unique @db.VarChar(30)
  name        String        @db.VarChar(120)
  gradeId     String        @map("grade_id") @db.Uuid
  description String?       @db.VarChar(1000)
  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  grade      TeaGrade            @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  createdBy  User                @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  batches    ProductBatch[]
  prices     PriceVersion[]
  orderLines OrderLine[]
  thresholds LowStockThreshold[]

  @@index([status])
  @@map("product")
}

/// Released finished batches offered under a product (the app refuses unreleased batches – US-048).
model ProductBatch {
  productId       String   @map("product_id") @db.Uuid
  finishedBatchId String   @map("finished_batch_id") @db.Uuid
  addedById       String   @map("added_by_id") @db.Uuid
  addedAt         DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  addedBy       User             @relation("ProductBatchAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@id([productId, finishedBatchId])
  @@index([finishedBatchId])
  @@map("product_batch")
}

/// US-049..055. Table name sales_order ("order" is an SQL keyword). version = optimistic-lock counter.
/// CHECK subtotal >= 0; REJECTED needs rejection_reason; CANCELLED needs cancel_reason.
model SalesOrder {
  id              String      @id @default(uuid()) @db.Uuid
  orderNo         String      @unique @map("order_no") @db.VarChar(20)
  buyerId         String      @map("buyer_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @default(0) @db.Decimal(14, 2)
  currency        String      @default("LKR") @db.VarChar(3)
  notes           String?     @db.VarChar(500)
  placedById      String      @map("placed_by_id") @db.Uuid
  placedAt        DateTime    @default(now()) @map("placed_at") @db.Timestamptz(3)
  confirmedById   String?     @map("confirmed_by_id") @db.Uuid
  confirmedAt     DateTime?   @map("confirmed_at") @db.Timestamptz(3)
  rejectionReason String?     @map("rejection_reason") @db.VarChar(500)
  cancelledById   String?     @map("cancelled_by_id") @db.Uuid
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?     @map("cancel_reason") @db.VarChar(500)
  packedAt        DateTime?   @map("packed_at") @db.Timestamptz(3)
  dispatchedAt    DateTime?   @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz(3)
  version         Int         @default(0)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  buyer          Buyer                @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  placedBy       User                 @relation("OrderPlacedBy", fields: [placedById], references: [id], onDelete: Restrict)
  confirmedBy    User?                @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  cancelledBy    User?                @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines          OrderLine[]
  history        OrderStatusHistory[]
  invoice        Invoice?
  transportJobs  TransportJob[]
  stockMovements StockMovement[]

  @@index([buyerId, placedAt])
  @@index([status])
  @@map("sales_order")
}

/// unitPrice is copied from the selling price version at order time. CHECK quantity_kg > 0, unit_price >= 0,
/// line_total = round(quantity_kg * unit_price, 2).
model OrderLine {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantityKg     Decimal @map("quantity_kg") @db.Decimal(12, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 2)
  priceVersionId String? @map("price_version_id") @db.Uuid
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)

  order        SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  priceVersion PriceVersion?     @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  allocations  OrderAllocation[]

  @@unique([orderId, productId])
  @@map("order_line")
}

/// US-053. Which batch + location fills which order line (forward traceability to the buyer).
/// CHECK quantity_kg > 0.
model OrderAllocation {
  id              String           @id @default(uuid()) @db.Uuid
  orderLineId     String           @map("order_line_id") @db.Uuid
  finishedBatchId String           @map("finished_batch_id") @db.Uuid
  locationId      String           @map("location_id") @db.Uuid
  quantityKg      Decimal          @map("quantity_kg") @db.Decimal(12, 3)
  status          AllocationStatus @default(RESERVED)
  allocatedById   String           @map("allocated_by_id") @db.Uuid
  allocatedAt     DateTime         @default(now()) @map("allocated_at") @db.Timestamptz(3)
  releasedAt      DateTime?        @map("released_at") @db.Timestamptz(3)

  orderLine     OrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  finishedBatch FinishedTeaBatch @relation(fields: [finishedBatchId], references: [id], onDelete: Restrict)
  location      StorageLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  allocatedBy   User             @relation("AllocationBy", fields: [allocatedById], references: [id], onDelete: Restrict)

  @@index([orderLineId])
  @@index([finishedBatchId])
  @@map("order_allocation")
}

/// US-055 status history. Append-only (trigger).
model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  reason      String?      @db.VarChar(500)
  changedById String       @map("changed_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User       @relation("OrderHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// US-056 (Should). One invoice per order. CHECK amounts >= 0, total = subtotal + tax_amount.
model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceNo   String        @unique @map("invoice_no") @db.VarChar(20)
  orderId     String        @unique @map("order_id") @db.Uuid
  issuedAt    DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  dueDate     DateTime?     @map("due_date") @db.Date
  subtotal    Decimal       @db.Decimal(14, 2)
  taxAmount   Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total       Decimal       @db.Decimal(14, 2)
  currency    String        @default("LKR") @db.VarChar(3)
  status      InvoiceStatus @default(UNPAID)
  issuedById  String        @map("issued_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order    SalesOrder       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  issuedBy User             @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  payments InvoicePayment[]

  @@index([status])
  @@map("invoice")
}

/// Payment outcome recorded against an invoice (the money moves outside the system). CHECK amount > 0.
model InvoicePayment {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  paidAt       DateTime @map("paid_at") @db.Timestamptz(3)
  reference    String   @db.VarChar(80)
  method       String?  @db.VarChar(40)
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("InvoicePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_payment")
}

// ═══════════════════════════════════════ M10 PRICING ══════════════════════════════════════════════

/// US-057..059. Every change is a new version; past transactions keep their copied price.
/// PURCHASE_GL = green-leaf purchase price (no grade/product); SELLING_FT = selling price for a grade or product.
/// DRAFT → APPROVED (or REJECTED) by Management; approver should differ from creator (app, pending client).
/// CHECK version >= 1, price_per_kg >= 0, effective_to NULL or > effective_from, REJECTED needs reason.
model PriceVersion {
  id              String      @id @default(uuid()) @db.Uuid
  priceType       PriceType   @map("price_type")
  version         Int
  pricePerKg      Decimal     @map("price_per_kg") @db.Decimal(12, 2)
  currency        String      @default("LKR") @db.VarChar(3)
  effectiveFrom   DateTime    @map("effective_from") @db.Timestamptz(3)
  status          PriceStatus @default(DRAFT)
  effectiveTo     DateTime?   @map("effective_to") @db.Timestamptz(3)
  gradeId         String?     @map("grade_id") @db.Uuid
  productId       String?     @map("product_id") @db.Uuid
  createdById     String?     @map("created_by_id") @db.Uuid
  approvedById    String?     @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?   @map("approved_at") @db.Timestamptz(3)
  rejectionReason String?     @map("rejection_reason") @db.VarChar(300)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  grade       TeaGrade?    @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation("PriceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?        @relation("PriceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  collections Collection[]
  orderLines  OrderLine[]

  @@unique([priceType, version])
  @@index([priceType, status, effectiveFrom])
  @@map("price_version")
}

// ═══════════════════════════════════ M11 FARMER PAYMENTS ══════════════════════════════════════════

/// US-060. Bonus / deduction rules (versioned, Management approves). CHECK value >= 0, version >= 1,
/// QUALITY_DECISION needs decision, GRADE needs grade_id, MIN_PERIOD_KG needs min_period_kg.
model PaymentAdjustmentRule {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @db.VarChar(30)
  version       Int                 @default(1)
  name          String              @db.VarChar(120)
  type          AdjustmentRuleType
  basis         AdjustmentBasis
  value         Decimal             @db.Decimal(12, 3)
  condition     AdjustmentCondition @default(ALWAYS)
  decision      LeafDecision?
  gradeId       String?             @map("grade_id") @db.Uuid
  minPeriodKg   Decimal?            @map("min_period_kg") @db.Decimal(12, 3)
  reason        String              @db.VarChar(300)
  status        ApprovalStatus      @default(DRAFT)
  effectiveFrom DateTime?           @map("effective_from") @db.Timestamptz(3)
  createdById   String              @map("created_by_id") @db.Uuid
  approvedById  String?             @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  grade       TeaGrade?                 @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  createdBy   User                      @relation("AdjRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?                     @relation("AdjRuleApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  adjustments FarmerPaymentAdjustment[]

  @@unique([code, version])
  @@index([status])
  @@map("payment_adjustment_rule")
}

/// US-061..064. One payment per producer per period: PREPARED → APPROVED | REJECTED → PAID.
/// CHECK period_end >= period_start; amounts: total = base + adjustments_total, total >= 0;
/// APPROVED/PAID need approved_by_id; PAID needs paid_at + payment_reference; REJECTED needs reason.
model FarmerPayment {
  id               String              @id @default(uuid()) @db.Uuid
  paymentNo        String              @unique @map("payment_no") @db.VarChar(20)
  producerId       String              @map("producer_id") @db.Uuid
  periodStart      DateTime            @map("period_start") @db.Date
  periodEnd        DateTime            @map("period_end") @db.Date
  totalNetKg       Decimal             @map("total_net_kg") @db.Decimal(12, 3)
  baseAmount       Decimal             @map("base_amount") @db.Decimal(14, 2)
  adjustmentsTotal Decimal             @default(0) @map("adjustments_total") @db.Decimal(14, 2)
  totalAmount      Decimal             @map("total_amount") @db.Decimal(14, 2)
  currency         String              @default("LKR") @db.VarChar(3)
  status           FarmerPaymentStatus @default(PREPARED)
  preparedById     String              @map("prepared_by_id") @db.Uuid
  preparedAt       DateTime            @default(now()) @map("prepared_at") @db.Timestamptz(3)
  approvedById     String?             @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz(3)
  rejectionReason  String?             @map("rejection_reason") @db.VarChar(500)
  paidAt           DateTime?           @map("paid_at") @db.Timestamptz(3)
  paymentReference String?             @map("payment_reference") @db.VarChar(80)
  markedPaidById   String?             @map("marked_paid_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  producer    Producer                  @relation(fields: [producerId], references: [id], onDelete: Restrict)
  preparedBy  User                      @relation("PaymentPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  approvedBy  User?                     @relation("PaymentApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  markedPaidBy User?                    @relation("PaymentMarkedPaidBy", fields: [markedPaidById], references: [id], onDelete: Restrict)
  lines       FarmerPaymentLine[]
  adjustments FarmerPaymentAdjustment[]

  @@unique([producerId, periodStart, periodEnd])
  @@index([status])
  @@map("farmer_payment")
}

/// One line per collection; a collection can be paid only once (unique collection_id).
/// CHECK net_kg >= 0, price_per_kg >= 0, amount >= 0.
model FarmerPaymentLine {
  id           String   @id @default(uuid()) @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  collectionId String   @unique @map("collection_id") @db.Uuid
  netKg        Decimal  @map("net_kg") @db.Decimal(10, 3)
  pricePerKg   Decimal  @map("price_per_kg") @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(14, 2)

  payment    FarmerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  collection Collection    @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("farmer_payment_line")
}

/// Bonus (+) or deduction (−) applied to a payment, from a rule or entered manually.
model FarmerPaymentAdjustment {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  ruleId      String?  @map("rule_id") @db.Uuid
  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(14, 2)

  payment FarmerPayment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  rule    PaymentAdjustmentRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("farmer_payment_adjustment")
}

// ═══════════════════════════════════════ M12 TRANSPORT ════════════════════════════════════════════

/// US-065 (Could). A transporter (person or company) with an optional login (role TRN).
model Transporter {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(120)
  companyName String?  @map("company_name") @db.VarChar(160)
  phone       String?  @db.VarChar(20)
  userId      String?  @unique @map("user_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?          @relation("TransporterUser", fields: [userId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]
  drivers  Driver[]
  jobs     TransportJob[]

  @@map("transporter")
}

/// CHECK capacity_kg NULL or > 0.
model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  regNo         String   @unique @map("reg_no") @db.VarChar(20)
  type          String?  @db.VarChar(40)
  capacityKg    Decimal? @map("capacity_kg") @db.Decimal(10, 3)
  transporterId String   @map("transporter_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transporter Transporter    @relation(fields: [transporterId], references: [id], onDelete: Restrict)
  jobs        TransportJob[]

  @@map("vehicle")
}

model Driver {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(120)
  licenseNo     String   @unique @map("license_no") @db.VarChar(30)
  phone         String?  @db.VarChar(20)
  transporterId String   @map("transporter_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  transporter Transporter    @relation(fields: [transporterId], references: [id], onDelete: Restrict)
  jobs        TransportJob[]

  @@map("driver")
}

/// US-066..068. COLLECTION jobs carry one or more CollectionRequests; DELIVERY jobs carry one order.
/// CHECK DELIVERY ⇔ order_id set; FAILED/DELAYED need failure_reason.
model TransportJob {
  id            String             @id @default(uuid()) @db.Uuid
  jobNo         String             @unique @map("job_no") @db.VarChar(20)
  type          TransportJobType
  status        TransportJobStatus @default(ASSIGNED)
  transporterId String             @map("transporter_id") @db.Uuid
  vehicleId     String?            @map("vehicle_id") @db.Uuid
  driverId      String?            @map("driver_id") @db.Uuid
  orderId       String?            @map("order_id") @db.Uuid
  assignedById  String             @map("assigned_by_id") @db.Uuid
  scheduledAt   DateTime?          @map("scheduled_at") @db.Timestamptz(3)
  pickedUpAt    DateTime?          @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt   DateTime?          @map("delivered_at") @db.Timestamptz(3)
  failureReason String?            @map("failure_reason") @db.VarChar(500)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  transporter        Transporter         @relation(fields: [transporterId], references: [id], onDelete: Restrict)
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver             Driver?             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  order              SalesOrder?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignedBy         User                @relation("JobAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  collectionRequests CollectionRequest[]
  events             TransportJobEvent[]
  proof              ProofOfDelivery?

  @@index([transporterId, status])
  @@index([orderId])
  @@map("transport_job")
}

/// Pickup / delivery milestones with time and optional GPS. Append-only (trigger).
model TransportJobEvent {
  id           String             @id @default(uuid()) @db.Uuid
  jobId        String             @map("job_id") @db.Uuid
  status       TransportJobStatus
  note         String?            @db.VarChar(500)
  gpsLat       Float?             @map("gps_lat")
  gpsLng       Float?             @map("gps_lng")
  recordedById String             @map("recorded_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  job        TransportJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  recordedBy User         @relation("JobEventRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@map("transport_job_event")
}

/// US-067. CHECK signature_url or photo_url is set.
model ProofOfDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  jobId         String   @unique @map("job_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(120)
  signatureUrl  String?  @map("signature_url") @db.VarChar(500)
  photoUrl      String?  @map("photo_url") @db.VarChar(500)
  notes         String?  @db.VarChar(500)
  capturedById  String   @map("captured_by_id") @db.Uuid
  capturedAt    DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  job        TransportJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  capturedBy User         @relation("ProofCapturedBy", fields: [capturedById], references: [id], onDelete: Restrict)

  @@map("proof_of_delivery")
}

// ═════════════════════════════════════ M13 NOTIFICATIONS ══════════════════════════════════════════

/// US-069. In-app notifications; a user only ever reads their own.
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  eventType  String    @map("event_type") @db.VarChar(60)
  title      String    @db.VarChar(160)
  message    String    @db.VarChar(1000)
  entityType String?   @map("entity_type") @db.VarChar(60)
  entityId   String?   @map("entity_id") @db.VarChar(60)
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notification")
}

/// US-070 (Could). Which events notify which roles. CHECK cardinality(recipient_roles) > 0.
model AlertRule {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(120)
  eventType      String   @map("event_type") @db.VarChar(60)
  recipientRoles Role[]   @map("recipient_roles")
  isActive       Boolean  @default(true) @map("is_active")
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User @relation("AlertRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([eventType, isActive])
  @@map("alert_rule")
}

// ══════════════════════════════════════════ UTILITIES ═════════════════════════════════════════════

/// Sequence counters: "RC", "PRD", "GL-2026-11", "F-00417", "PB-2026-11", "SO" … See services/counter.js.
model Counter {
  id  String @id
  seq Int    @default(0)

  @@map("counter")
}
