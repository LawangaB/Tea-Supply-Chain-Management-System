// Smart Tea – PostgreSQL schema (Neon in production). CODE-FIRST: this file is the single source of truth.
// Every database change starts here, then `npx prisma migrate dev --name <change>` generates the migration.
// Never change the database by hand (Neon console, psql) – the next deploy would undo it or fail.
//
// Connection URLs live in prisma.config.js (Prisma 7). Business rules that the database can enforce
// (CHECK constraints, append-only triggers) are in prisma/migrations/*_rules/migration.sql. A comment
// "CHECK ..." on a model lists the rules that exist for it there. See docs/DATABASE.md.
//
// Conventions: snake_case tables/columns via @map, UUID ids (generated by Prisma), money DECIMAL(…,2),
// weights in kg DECIMAL(…,3), timestamps TIMESTAMPTZ(3). Approve/reject workflows store who + when + why.
// Records with history are deactivated, never deleted (onDelete: Restrict).
//
// Modules (Role & Permission Matrix v2): M1 admin/security · M2 producers · M3 collection · M4 leaf quality ·
// M5 processing · M6 finished-tea quality · M7 traceability · M8 warehouse · M9 buyers/orders ·
// M10 pricing · M11 farmer payments · M12 transport · M13 notifications · (M14 reports = queries, no tables)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═════════════════════════════════════════════ ENUMS ═════════════════════════════════════════════

/// rules/permissions.js ROLE_CODES
enum Role {
  ADM
  MGT
  FRM
  COL
  FAC
  QO
  WH
  BUY
  TRN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ProducerType {
  SMALLHOLDER
  ESTATE
  ORG_MEMBER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FieldStatus {
  ACTIVE
  INACTIVE
}

/// Green-leaf batch life cycle: IN_TRANSIT → RECEIVED (factory) → ACCEPTED | ADJUSTED | REJECTED (QO) → CONSUMED.
enum BatchStatus {
  IN_TRANSIT
  RECEIVED
  ACCEPTED
  ADJUSTED
  REJECTED
  CONSUMED
}

enum PriceType {
  PURCHASE_GL
  SELLING_FT
}

/// DRAFT = proposed, waiting for Management approval (US-058).
enum PriceStatus {
  DRAFT
  APPROVED
  RETIRED
  REJECTED
}

/// Scope of a permission: 'all' records, 'own' records, or records 'assigned' to the user (transporter).
enum PermissionScope {
  ALL
  OWN
  ASSIGNED
}

/// Master data and rules with a draft → Management approval step (US-007, US-027, US-060).
enum ApprovalStatus {
  DRAFT
  ACTIVE
  REJECTED
  RETIRED
}

/// Simple request → approve/reject decisions (stock adjustments, thresholds).
enum DecisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SettingCategory {
  SECURITY
  TECHNICAL
  BUSINESS
}

/// US-013: administrators see SECURITY/TECHNICAL events, Management sees BUSINESS events.
enum AuditCategory {
  BUSINESS
  SECURITY
  TECHNICAL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum BackupKind {
  BACKUP
  RESTORE
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum CollectionRequestStatus {
  REQUESTED
  SCHEDULED
  COLLECTED
  CANCELLED
}

enum ReceiptReviewStatus {
  NOT_REQUIRED
  PENDING
  RESOLVED
}

enum InspectionSubject {
  GREEN_LEAF
  FINISHED_TEA
}

/// US-025 quality decision for a green-leaf batch.
enum LeafDecision {
  ACCEPTED
  ACCEPTED_WITH_ADJUSTMENT
  REJECTED
}

enum ToleranceType {
  RECEIPT_WEIGHT
  PROCESSING_VARIANCE
  STOCK_COUNT
}

enum ProcessingStatus {
  OPEN
  COMPLETED
  RECONCILED
  CANCELLED
}

enum ProcessingStageType {
  WITHERING
  ROLLING
  OXIDATION
  DRYING
  SORTING
  GRADING
  PACKING
  OTHER
}

enum ReconciliationStatus {
  AUTO_ACCEPTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ReleaseStatus {
  NOT_RELEASED
  RELEASED
  ON_HOLD
}

enum ReleaseAction {
  RELEASE
  HOLD
  REVOKE
}

enum TraceIssueType {
  MISSING_PROCESSING_SOURCE
  MISSING_LEAF_INPUT
  MISSING_COLLECTION_LINK
}

enum StockMovementType {
  STOCK_IN
  TRANSFER
  ADJUSTMENT
  RESERVE
  RELEASE_RESERVATION
  DISPATCH
}

enum AdjustmentReason {
  DAMAGED
  DOWNGRADED
  COUNT_DIFFERENCE
  OTHER
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
}

enum BuyerStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

/// US-049..055. Allowed transitions are enforced in the app (rules/orderStatus.js).
enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  RESERVED
  PACKED
  DISPATCHED
  DELIVERED
}

enum AllocationStatus {
  RESERVED
  RELEASED
  DISPATCHED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum AdjustmentRuleType {
  BONUS
  DEDUCTION
}

enum AdjustmentBasis {
  PER_KG
  PERCENT
  FIXED
}

enum AdjustmentCondition {
  ALWAYS
  QUALITY_DECISION
  GRADE
  MIN_PERIOD_KG
}

enum FarmerPaymentStatus {
  PREPARED
  APPROVED
  REJECTED
  PAID
}

enum TransportJobType {
  COLLECTION
  DELIVERY
}

enum TransportJobStatus {
